<mujoco model="Simple_Door_Test">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
  
  <default>
    <geom contype="1" conaffinity="1" density="1000"/>
    <joint armature="0.01" damping="1.0"/>
  </default>

  <asset>
    <material name="mat_box" rgba="0.6 0.6 0.6 1"/>
    <material name="mat_door" rgba="0.2 0.4 0.8 1"/>
  </asset>

  <worldbody>
    <!-- Floor for contact -->
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.9 0.9 0.9 1"/>
    
    <!-- Box Base (using primitive shapes instead of STL) -->
    <body name="Base_Box" pos="0 0 0.1">
      <!-- Main box body -->
      <geom name="box_main" type="box" size="0.2 0.15 0.1" material="mat_box"/>
      
      <!-- Door attached to the box -->
      <body name="Hinged_Door" pos="0.2 0 0">
        <!-- Hinge joint -->
        <joint name="door_hinge" 
               type="hinge" 
               pos="0 -0.15 0" 
               axis="0 0 1" 
               range="0 90"/>
        
        <!-- Door geometry -->
        <geom name="door_geom" type="box" size="0.02 0.15 0.08" pos="0.02 0 0.02" material="mat_door"/>
      </body>
    </body>
  </worldbody>
</mujoco>
