<mujoco model="Kuka iiwa14 with Robotiq 2f85 Gripper">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>
  
  <option cone="elliptic" impratio="10"/>

  <statistic center="0.2 0 0.4" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-120" elevation="-20"/>
  </visual>

  <asset>
    <!-- Kuka iiwa14 meshes -->
    <mesh name="base" file="../mujoco_menagerie/kuka_iiwa_14/assets/base.stl"/>
    <mesh name="link1" file="../mujoco_menagerie/kuka_iiwa_14/assets/link1.stl"/>
    <mesh name="link2" file="../mujoco_menagerie/kuka_iiwa_14/assets/link2.stl"/>
    <mesh name="link3" file="../mujoco_menagerie/kuka_iiwa_14/assets/link3.stl"/>
    <mesh name="link4" file="../mujoco_menagerie/kuka_iiwa_14/assets/link4.stl"/>
    <mesh name="link5" file="../mujoco_menagerie/kuka_iiwa_14/assets/link5.stl"/>
    <mesh name="link6" file="../mujoco_menagerie/kuka_iiwa_14/assets/link6.stl"/>
    <mesh name="link7" file="../mujoco_menagerie/kuka_iiwa_14/assets/link7.stl"/>

    <!-- Robotiq 2f85 meshes -->
    <material name="metal" rgba="0.58 0.58 0.58 1"/>
    <material name="silicone" rgba="0.1882 0.1882 0.1882 1"/>
    <material name="gray" rgba="0.4627 0.4627 0.4627 1"/>
    <material name="black" rgba="0.149 0.149 0.149 1"/>

    <mesh name="2f85_base_mount" file="base_mount.stl" scale="0.001 0.001 0.001"/>
    <mesh name="2f85_base" file="base.stl" scale="0.001 0.001 0.001"/>
    <mesh name="2f85_driver" file="driver.stl" scale="0.001 0.001 0.001"/>
    <mesh name="2f85_coupler" file="coupler.stl" scale="0.001 0.001 0.001"/>
    <mesh name="2f85_follower" file="follower.stl" scale="0.001 0.001 0.001"/>
    <mesh name="2f85_pad" file="pad.stl" scale="0.001 0.001 0.001"/>
    <mesh name="2f85_silicone_pad" file="silicone_pad.stl" scale="0.001 0.001 0.001"/>
    <mesh name="2f85_spring_link" file="spring_link.stl" scale="0.001 0.001 0.001"/>

    <!-- Environment textures -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <default>
    <joint axis="0 0 1" range="-3.14159 3.14159"/>
    <geom type="mesh" rgba="0.7 0.7 0.7 1"/>
    
    <default class="gripper">
      <joint axis="1 0 0" range="0 0.8" armature="0.005" damping="0.1"/>
      <geom type="mesh" group="3"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    
    <!-- Objects to manipulate -->
    <body name="red_cube" pos="0.4 0.2 0.075">
      <freejoint name="red_cube_joint"/>
      <geom name="red_cube_geom" type="box" size="0.025 0.025 0.025" rgba="0.9 0.2 0.2 1" mass="0.1"/>
    </body>
    
    <body name="blue_cube" pos="0.4 -0.2 0.075">
      <freejoint name="blue_cube_joint"/>
      <geom name="blue_cube_geom" type="box" size="0.03 0.025 0.02" rgba="0.2 0.2 0.9 1" mass="0.12"/>
    </body>
    
    <body name="green_cylinder" pos="0.5 0 0.065">
      <freejoint name="green_cylinder_joint"/>
      <geom name="green_cylinder_geom" type="cylinder" size="0.02 0.03" rgba="0.2 0.9 0.2 1" mass="0.08"/>
    </body>

    <!-- Kuka iiwa14 Robot Arm -->
    <body name="base" pos="0 0 0">
      <geom mesh="base" rgba="0.7 0.7 0.7 1"/>
      <body name="link1" pos="0 0 0.1575">
        <joint name="joint1" axis="0 0 1" range="-2.96706 2.96706"/>
        <geom mesh="link1" rgba="0.4 0.4 0.4 1"/>
        <body name="link2" pos="0 0 0.2025" quat="1 0 1 0">
          <joint name="joint2" axis="0 0 1" range="-2.09440 2.09440"/>
          <geom mesh="link2" rgba="0.4 0.4 0.4 1"/>
          <body name="link3" pos="0 0 0.2045" quat="1 0 -1 0">
            <joint name="joint3" axis="0 0 1" range="-2.96706 2.96706"/>
            <geom mesh="link3" rgba="0.4 0.4 0.4 1"/>
            <body name="link4" pos="0 0 0.2155" quat="1 0 1 0">
              <joint name="joint4" axis="0 0 1" range="-2.09440 2.09440"/>
              <geom mesh="link4" rgba="0.4 0.4 0.4 1"/>
              <body name="link5" pos="0 0 0.1845" quat="1 0 -1 0">
                <joint name="joint5" axis="0 0 1" range="-2.96706 2.96706"/>
                <geom mesh="link5" rgba="0.4 0.4 0.4 1"/>
                <body name="link6" pos="0 0 0.2155" quat="1 0 1 0">
                  <joint name="joint6" axis="0 0 1" range="-2.09440 2.09440"/>
                  <geom mesh="link6" rgba="0.4 0.4 0.4 1"/>
                  <body name="link7" pos="0 0 0.081" quat="1 0 -1 0">
                    <joint name="joint7" axis="0 0 1" range="-3.05433 3.05433"/>
                    <geom mesh="link7" rgba="0.7 0.7 0.7 1"/>

                    <!-- Simple Robotiq 2f85 Style Gripper -->
                    <body name="gripper_base" pos="0 0 0.045">
                      <geom name="gripper_palm" type="box" size="0.04 0.03 0.02" rgba="0.3 0.3 0.3 1"/>
                      
                      <!-- Left finger -->
                      <body name="left_finger" pos="0 0.03 0.03">
                        <joint name="left_finger_joint" class="gripper"/>
                        <geom name="left_finger_geom" type="box" size="0.01 0.03 0.02" rgba="0.5 0.5 0.5 1"/>
                      </body>
                      
                      <!-- Right finger -->
                      <body name="right_finger" pos="0 -0.03 0.03">
                        <joint name="right_finger_joint" class="gripper" range="0 0.8"/>
                        <geom name="right_finger_geom" type="box" size="0.01 0.03 0.02" rgba="0.5 0.5 0.5 1"/>
                      </body>

                      <!-- Gripper tip site for positioning -->
                      <site name="gripper_center" pos="0 0 0.08" size="0.005" rgba="1 0 0 1"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Actuators for robot arm and gripper -->
  <actuator>
    <!-- Robot arm actuators -->
    <general name="actuator1" joint="joint1" ctrlrange="-2.96706 2.96706" gainprm="300"/>
    <general name="actuator2" joint="joint2" ctrlrange="-2.09440 2.09440" gainprm="300"/>
    <general name="actuator3" joint="joint3" ctrlrange="-2.96706 2.96706" gainprm="300"/>
    <general name="actuator4" joint="joint4" ctrlrange="-2.09440 2.09440" gainprm="300"/>
    <general name="actuator5" joint="joint5" ctrlrange="-2.96706 2.96706" gainprm="300"/>
    <general name="actuator6" joint="joint6" ctrlrange="-2.09440 2.09440" gainprm="300"/>
    <general name="actuator7" joint="joint7" ctrlrange="-3.05433 3.05433" gainprm="300"/>
    
    <!-- Gripper actuators -->
    <general name="left_finger_actuator" joint="left_finger_joint" ctrlrange="0 0.8" gainprm="500"/>
    <general name="right_finger_actuator" joint="right_finger_joint" ctrlrange="0 0.8" gainprm="500"/>
  </actuator>

  <!-- Contact properties for grasping -->
  <contact>
    <!-- Enhanced friction for grasping -->
    <pair geom1="left_finger_geom" geom2="red_cube_geom" condim="4" friction="1.5 0.1 0.001"/>
    <pair geom1="right_finger_geom" geom2="red_cube_geom" condim="4" friction="1.5 0.1 0.001"/>
    <pair geom1="left_finger_geom" geom2="blue_cube_geom" condim="4" friction="1.5 0.1 0.001"/>
    <pair geom1="right_finger_geom" geom2="blue_cube_geom" condim="4" friction="1.5 0.1 0.001"/>
    <pair geom1="left_finger_geom" geom2="green_cylinder_geom" condim="4" friction="1.5 0.1 0.001"/>
    <pair geom1="right_finger_geom" geom2="green_cylinder_geom" condim="4" friction="1.5 0.1 0.001"/>
  </contact>

  <!-- Sensors -->
  <sensor>
    <!-- Robot arm joint positions -->
    <jointpos name="joint1_pos" joint="joint1"/>
    <jointpos name="joint2_pos" joint="joint2"/>
    <jointpos name="joint3_pos" joint="joint3"/>
    <jointpos name="joint4_pos" joint="joint4"/>
    <jointpos name="joint5_pos" joint="joint5"/>
    <jointpos name="joint6_pos" joint="joint6"/>
    <jointpos name="joint7_pos" joint="joint7"/>
    
    <!-- Gripper positions -->
    <jointpos name="left_finger_pos" joint="left_finger_joint"/>
    <jointpos name="right_finger_pos" joint="right_finger_joint"/>
  </sensor>

  <!-- Keyframes for different poses -->
  <keyframe>
    <key name="home" qpos="0 0 0 -1.5708 0 1.5708 0 0 0"/>
    <key name="ready_grasp" qpos="0.2 0.5 0 -1.2 0 1.0 0 0.2 0.2"/>
    <key name="open_gripper" qpos="0 0 0 -1.5708 0 1.5708 0 0 0"/>
    <key name="closed_gripper" qpos="0 0 0 -1.5708 0 1.5708 0 0.6 0.6"/>
  </keyframe>
</mujoco>
