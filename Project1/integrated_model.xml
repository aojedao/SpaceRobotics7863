          <geom class="collision" size="0.07" pos="-0.01 0.04 0.054"/>
          <geom class="collision" size="0.065" pos="-0.01 0.09 0.04"/>
          <geom class="collision" size="0.065" pos="-0.01 0.13 0.02"/>
          <geom class="collision" size="0.07" pos="0.01 0.04 0.054"/>
          <geom class="collision" size="0.065" pos="0.01 0.09 0.04"/>
