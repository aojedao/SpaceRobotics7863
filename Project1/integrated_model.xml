    <material name="gripper_silicone" rgba="0.1882 0.1882 0.1882 1"/>
    <material name="gripper_gray" rgba="0.4627 0.4627 0.4627 1"/>
    <material name="gripper_black" rgba="0.149 0.149 0.149 1"/>
    
    <!-- Box/Door materials -->
